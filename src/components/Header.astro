---
// Brand mark is inlined (mono variant uses currentColor) so it follows the theme.
const path = Astro.url.pathname;
const norm = path.length > 1 ? path.replace(/\/$/, '') : path;
const links = [
  { href: '/getting-started', label: 'Getting started' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/release-notes', label: 'Release notes' },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Weft — home">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" aria-hidden="true" fill="none">
        <rect x="16.88" y="12.96" width="8.64" height="74.07" rx="4.32" fill="currentColor" /><rect x="31.28" y="12.96" width="8.64" height="74.07" rx="4.32" fill="currentColor" /><rect x="45.68" y="12.96" width="8.64" height="74.07" rx="4.32" fill="currentColor" /><rect x="60.08" y="12.96" width="8.64" height="74.07" rx="4.32" fill="currentColor" /><rect x="74.48" y="12.96" width="8.64" height="74.07" rx="4.32" fill="currentColor" /><rect x="12.96" y="16.88" width="74.07" height="8.64" rx="4.32" fill="currentColor" /><rect x="12.96" y="31.28" width="74.07" height="8.64" rx="4.32" fill="currentColor" /><rect x="12.96" y="45.68" width="74.07" height="8.64" rx="4.32" fill="currentColor" /><rect x="12.96" y="60.08" width="74.07" height="8.64" rx="4.32" fill="currentColor" /><rect x="12.96" y="74.48" width="74.07" height="8.64" rx="4.32" fill="currentColor" /><rect x="16.88" y="14" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="45.68" y="14" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="74.48" y="14" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="31.28" y="28.4" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="60.08" y="28.4" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="16.88" y="42.8" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="45.68" y="42.8" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="74.48" y="42.8" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="31.28" y="57.2" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="60.08" y="57.2" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="16.88" y="71.6" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="45.68" y="71.6" width="8.64" height="14.4" rx="2.59" fill="currentColor" /><rect x="74.48" y="71.6" width="8.64" height="14.4" rx="2.59" fill="currentColor" />
      </svg>
      Weft
    </a>

    <nav class="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={norm === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="https://github.com/MennoAf/weft" rel="me noreferrer">GitHub</a>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </nav>
  </div>
</header>
